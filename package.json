{
  "name": "datavis-ace",
  "version": "4.1.0-PRE.0",
  "description": "DataVis ACE (Acquisition + Computation Engine)",
  "keywords": [
    "data",
    "filter",
    "group",
    "pivot",
    "aggregation"
  ],
  "type": "module",
  "license": "see LICENSE",
  "author": "Taylor Venable <tvenable@mieweb.com>",
  "files": [
    "index.js",
    "src/*.js",
    "src/**/*.js"
  ],
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/mieweb/datavis-ace.git"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint src tests/unit",
    "pretest": "make -C tests/data",
    "test": "mocha --timeout 10000 --recursive 'tests/unit/**/*.js'",
    "rollup": "rollup --bundleConfigAsCjs -c rollup.config.js",
    "uglify": "uglifyjs -c -o dist/wcdatavis.min.js dist/wcdatavis.js"
  },
  "dependencies": {
    "bignumber.js": "=9.3.1",
    "core-js": "=3.49.0",
    "es6-symbol": "=3.1.4",
    "json-formatter-js": "https://github.com/mieweb/json-formatter-js.git",
    "moment": "=2.30.1",
    "numeral": "=2.0.6",
    "papaparse": "=5.5.4",
    "sprintf-js": "=1.1.3",
    "underscore": "=1.13.8"
  },
  "devDependencies": {
    "@babel/core": "=7.29.7",
    "@babel/preset-env": "=7.29.7",
    "@rollup/plugin-babel": "=6.1.0",
    "@rollup/plugin-commonjs": "=29.0.3",
    "@rollup/plugin-node-resolve": "=16.0.3",
    "@rollup/plugin-replace": "=6.0.3",
    "@stylistic/eslint-plugin": "=5.10.0",
    "@types/mocha": "=10.0.10",
    "bluebird": "=3.7.2",
    "chai": "=6.2.2",
    "eslint": "=9.39.4",
    "eslint-plugin-import": "=2.32.0",
    "eslint-plugin-unused-imports": "=4.4.1",
    "globals": "=17.7.0",
    "jsdoc": "=4.0.5",
    "json5": "=2.2.3",
    "lodash": "=4.18.1",
    "mocha": "=11.7.6",
    "rollup": "=4.62.2",
    "uglify-js": "=3.19.3",
    "vite": "=7.3.5"
  }
}
